{
  "name": "endpoint-navigator",
  "displayName": "Endpoint Navigator",
  "description": "搜索并跳转 Java 项目中的 REST / WebSocket / Netty / xxl-job / MQ / 定时任务 / MyBatis Mapper 接口，支持正则与模糊搜索，支持 Swagger 中文描述反查。",
  "version": "0.12.0",
  "publisher": "dsda56180",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsda56180/endpoint-navigator.git"
  },
  "bugs": {
    "url": "https://github.com/dsda56180/endpoint-navigator/issues"
  },
  "homepage": "https://github.com/dsda56180/endpoint-navigator#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "java",
    "spring",
    "endpoint",
    "controller",
    "swagger",
    "xxl-job",
    "netty",
    "navigation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "endpointNavigator.search",
        "title": "搜索接口",
        "category": "Endpoint Navigator"
      },
      {
        "command": "endpointNavigator.quickSearch",
        "title": "快速搜索（QuickPick）",
        "category": "Endpoint Navigator"
      },
      {
        "command": "endpointNavigator.refresh",
        "title": "重建索引",
        "category": "Endpoint Navigator"
      },
      {
        "command": "endpointNavigator.checkDuplicates",
        "title": "检查重复接口",
        "category": "Endpoint Navigator"
      },
      {
        "command": "endpointNavigator.export",
        "title": "导出接口清单",
        "category": "Endpoint Navigator"
      }
    ],
    "keybindings": [
      {
        "command": "endpointNavigator.search",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "Endpoint Navigator",
      "properties": {
        "endpointNavigator.enabledScanners": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rest",
              "stomp",
              "xxljob",
              "messaging",
              "mybatis",
              "regexRule"
            ]
          },
          "default": [
            "rest",
            "stomp",
            "xxljob",
            "messaging",
            "mybatis",
            "regexRule"
          ],
          "description": "启用的扫描器。"
        },
        "endpointNavigator.includeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.java"
          ],
          "description": "参与扫描的文件。"
        },
        "endpointNavigator.excludeGlobs": {
          "type": "string",
          "default": "**/{target,build,node_modules,out,dist,.git}/**",
          "description": "排除的目录。"
        },
        "endpointNavigator.contextPath": {
          "type": "string",
          "default": "",
          "description": "全局路径前缀，例如 /api。仅影响 REST 接口的展示路径。"
        },
        "endpointNavigator.showUnresolved": {
          "type": "boolean",
          "default": true,
          "description": "显示未能解析的常量表达式（如 {ApiConstants.PATH}）。"
        },
        "endpointNavigator.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "在 Controller 方法上方显示完整接口路径。"
        },
        "endpointNavigator.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "悬浮映射注解时显示完整路径、中文描述与冲突提示。"
        },
        "endpointNavigator.ui.style": {
          "type": "string",
          "enum": [
            "classic",
            "card",
            "compact"
          ],
          "enumDescriptions": [
            "方案一：经典列表，方法徽标 + 路径 + 描述双行",
            "方案二：卡片式，突出中文描述与模块信息",
            "方案三：紧凑单行，适合快速扫读"
          ],
          "default": "classic",
          "description": "搜索面板的界面样式，也可在面板内直接切换。"
        },
        "endpointNavigator.customRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "pattern"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "规则唯一标识。"
              },
              "label": {
                "type": "string",
                "description": "标签栏显示名称，例如 Netty。"
              },
              "type": {
                "type": "string",
                "description": "归类到哪个类型，默认同 id。"
              },
              "globs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [
                  "**/*.java"
                ],
                "description": "规则生效的文件范围。"
              },
              "pattern": {
                "type": "string",
                "description": "正则表达式。推荐使用具名捕获组 path / name / description。"
              },
              "flags": {
                "type": "string",
                "default": "g",
                "description": "正则 flags，默认 g。"
              },
              "nameGroup": {
                "type": "string",
                "default": "name",
                "description": "作为名称的捕获组。"
              },
              "pathGroup": {
                "type": "string",
                "default": "path",
                "description": "作为路径的捕获组。"
              },
              "descriptionGroup": {
                "type": "string",
                "default": "description",
                "description": "作为描述（支持中文）的捕获组。"
              }
            }
          },
          "default": [],
          "description": "自定义正则规则扫描器。Netty 等特殊框架可通过此配置接入。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/selftest.ts --bundle --platform=node --format=cjs --outfile=dist/selftest.js --log-level=error && node dist/selftest.js",
    "package": "node scripts/publish.mjs --check",
    "publish:ovsx": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
